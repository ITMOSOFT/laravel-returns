{
  "name": "itmosoft/laravel-returns",
  "description": "Return merchandise authorization and inspection workflows for Laravel commerce applications.",
  "type": "library",
  "license": "MIT",
  "require": {"php": "^8.3", "illuminate/database": "^12.0 || ^13.0", "illuminate/support": "^12.0 || ^13.0", "illuminate/events": "^12.0 || ^13.0"},
  "require-dev": {"orchestra/testbench": "^10.0 || ^11.0", "phpunit/phpunit": "^11.0 || ^12.0"},
  "autoload": {"psr-4": {"ItmoSoft\\Returns\\": "src/"}},
  "autoload-dev": {"psr-4": {"ItmoSoft\\Returns\\Tests\\": "tests/"}},
  "extra": {"laravel": {"providers": ["ItmoSoft\\Returns\\ReturnsServiceProvider"]}},
  "scripts": {"test": "phpunit", "test-coverage": "phpunit --coverage-text"},
  "minimum-stability": "stable",
  "prefer-stable": true
}
